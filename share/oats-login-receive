#!/usr/bin/python3 -I
"""oats-login-receive: forced-command receiver for harness credentials (oats-project/oats#1786, OATS 9b1ed301).

Installed root-owned 0755 at /usr/local/sbin/oats-login-receive and reached ONLY through a dedicated key in root's
authorized_keys:  restrict,command="/usr/local/sbin/oats-login-receive" <key>
SSH_ORIGINAL_COMMAND is "install|remove|status <harness> <name>"; for install the credential comes on stdin.
Answers one JSON line {ok, harness, name, fingerprint, replacedAt} (plus "error" when ok is false).
Never prints, logs or echoes the credential; the fingerprint is a sha256 prefix.

The destination comes from the root-owned config (/etc/oats-login/receiver.json), never from the caller:
  {"teams": {"<name>": {"group": "<group that may read>", "harnesses": ["claude", ...],
                        "path": "/srv/oats-team/{name}/login/{harness}-token"}}}   (path optional; that is the default)
The file is root:<group> 0440, written atomically; its parent directories are created root-owned (0750 for the login dir).

With --credential <entry-id>, the key decides the destination: one dedicated key per entry,
  restrict,command="/usr/local/sbin/oats-login-receive --credential <entry-id>" <key>
SSH_ORIGINAL_COMMAND is only "install", "status" or "remove". The entry comes from the same config:
  {"credentials": {"<entry-id>": {"group": "<group that may read>", "access": "read-only",
                                  "path": "/srv/oats-team/<group-dir>/credentials/<file>"}}}
path is required, absolute and normalized, in a directory named credentials that no other entry and no teams destination
shares, which is root:<group> 0750
(created so; an existing one is refused, never changed, when it is anything else). The value is opaque:
strict UTF-8, no NUL, at most 65,536 bytes, surrounding whitespace stripped. The answer is one JSON line
{ok, entry, fingerprint, replacedAt} (plus "error"). access "read-only" is the only access this receiver writes.
"""
import datetime, grp, hashlib, json, os, re, stat, sys, syslog

CONFIG = "/etc/oats-login/receiver.json"
DEFAULT_PATH = "/srv/oats-team/{name}/login/{harness}-token"
HARNESSES = {"claude", "codex", "pi", "opencode"}
ACTIONS = ("install", "remove", "status")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
MAX_BYTES = 65536


class Refused(Exception):
    pass


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fingerprint(data):
    return "sha256:" + hashlib.sha256(data).hexdigest()[:16]


def root_owned_not_writable(path, want_dir):
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode):
        raise Refused(f"{path} is a symlink")
    if want_dir and not stat.S_ISDIR(st.st_mode) or not want_dir and not stat.S_ISREG(st.st_mode):
        raise Refused(f"{path} has the wrong type")
    if st.st_uid != 0 or st.st_mode & 0o022:
        raise Refused(f"{path} is not root-owned or is group/other-writable")


def load_config(path=CONFIG, section="teams"):
    try:
        root_owned_not_writable(path, want_dir=False)
        root_owned_not_writable(os.path.dirname(path), want_dir=True)
        with open(path) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        raise Refused("receiver config absent")
    except (ValueError, OSError) as e:
        raise Refused(f"receiver config unreadable: {type(e).__name__}")
    if not isinstance(cfg.get(section), dict):
        raise Refused(f"receiver config has no {section}")
    return cfg


def parse_command(raw):
    parts = (raw or "").split()
    if len(parts) != 3:
        raise Refused("usage: install|remove|status <harness> <name>")
    action, harness, name = parts
    if action not in ("install", "remove", "status"):
        raise Refused("unknown action")
    if harness not in HARNESSES:
        raise Refused("unknown harness")
    if not NAME_RE.match(name):
        raise Refused("bad name")
    return action, harness, name


def destination(cfg, harness, name):
    team = cfg["teams"].get(name)
    if not isinstance(team, dict):
        raise Refused("name not configured on this host")
    hs = team.get("harnesses")
    if not isinstance(hs, list) or harness not in hs:
        raise Refused("harness not enabled for this name")
    try:
        gid = grp.getgrnam(team["group"]).gr_gid
    except (KeyError, TypeError):
        raise Refused("configured group absent")
    path = (team.get("path") or DEFAULT_PATH).format(name=name, harness=harness)
    if not os.path.isabs(path) or ".." in path.split("/"):
        raise Refused("configured path is not absolute and normalized")
    return path, gid


def parse_entry(argv):
    if len(argv) != 2 or argv[0] != "--credential":
        raise Refused("usage: oats-login-receive [--credential <entry-id>]")
    # fullmatch: NAME_RE's $ also matches before a final newline.
    if not NAME_RE.fullmatch(argv[1]):
        raise Refused("bad entry id")
    return argv[1]


def parse_action(raw):
    parts = (raw or "").split()
    if len(parts) != 1 or parts[0] not in ACTIONS:
        raise Refused("usage: install|remove|status")
    return parts[0]


def credential_destination(cfg, entry):
    spec = cfg["credentials"].get(entry)
    if not isinstance(spec, dict):
        raise Refused("entry not configured on this host")
    if spec.get("access") != "read-only":
        raise Refused("access not supported by this receiver")
    try:
        group = spec["group"]
        gid = grp.getgrnam(group).gr_gid
    except (KeyError, TypeError):
        raise Refused("configured group absent")
    path = spec.get("path")
    if not isinstance(path, str) or not os.path.isabs(path) or canonical(path) != path:
        raise Refused("configured path is not absolute and normalized")
    if os.path.basename(os.path.dirname(path)) != "credentials":
        raise Refused("configured path is not in a credentials directory")
    # The key decides the entry, so a destination shared with another entry would let one person's key overwrite or
    # remove another person's credential.
    if any(shares_destination(path, other) for other in other_destinations(cfg, entry)):
        raise Refused("configured path is shared with another entry")
    return path, gid, group


def other_destinations(cfg, entry):
    """Every file another credentials entry or any teams destination names: never written for this entry."""
    for other_id, other in cfg["credentials"].items():
        if other_id != entry and isinstance(other, dict) and isinstance(other.get("path"), str):
            yield other["path"]
    teams = cfg.get("teams")
    for name, team in (teams.items() if isinstance(teams, dict) else ()):
        if not isinstance(team, dict) or not isinstance(team.get("harnesses"), list):
            continue
        template = team.get("path") or DEFAULT_PATH
        for harness in team["harnesses"]:
            try:
                yield template.format(name=name, harness=harness)
            except (AttributeError, IndexError, KeyError, TypeError, ValueError):
                continue  # harness mode cannot write a destination it cannot format


def canonical(path):
    """An absolute path as Linux resolves its spelling: normpath keeps exactly two leading slashes, which name root."""
    return "/" + os.path.normpath(path).lstrip("/")


def destination_names(path):
    """The file and its directory, as spelled and as resolved through the symlinks that exist now. Reads only."""
    names = set()
    for name in (path, os.path.dirname(path)):
        names.update((canonical(name), canonical(os.path.realpath(name))))
    return names


def shares_destination(path, other):
    """Whether other is path, or a file of its credentials directory, or that directory itself, by any spelling."""
    if not isinstance(other, str) or not os.path.isabs(other):
        return False
    return bool(destination_names(path) & destination_names(canonical(other)))


def credentials_dir(path, gid, group, create):
    """The credentials directory: created root:<group> 0750 (parents root 0755) when create is set; every existing
    component root-owned, not group/other-writable, no symlinks; an existing directory that is not root:<group> 0750 is
    refused and never chmodded or chowned. Answers None when it is absent and create is not set."""
    directory = os.path.dirname(path)
    if create:
        ensure_parents(path, gid)
    else:
        cur = "/"
        for p in directory.strip("/").split("/"):
            cur = os.path.join(cur, p)
            if not os.path.lexists(cur):
                return None
            root_owned_not_writable(cur, want_dir=True)
    st = os.lstat(directory)
    if st.st_gid != gid or stat.S_IMODE(st.st_mode) != 0o750:
        raise Refused(f"credentials directory is not root:{group} 0750")
    return directory


def ensure_parents(path, gid):
    """Create missing parents root-owned; the login dir itself root:<group> 0750. Existing ones must be root-owned, not writable by others, no symlinks."""
    login_dir = os.path.dirname(path)
    parts = login_dir.strip("/").split("/")
    cur = "/"
    for i, p in enumerate(parts):
        cur = os.path.join(cur, p)
        last = i == len(parts) - 1
        if not os.path.lexists(cur):
            os.mkdir(cur, 0o750 if last else 0o755)
            os.chown(cur, 0, gid if last else 0)
            os.chmod(cur, 0o750 if last else 0o755)
        root_owned_not_writable(cur, want_dir=True)
    return login_dir


def read_credential(stream):
    data = stream.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise Refused("credential too large")
    data = data.strip()
    if not data:
        raise Refused("empty credential")
    if b"\0" in data:
        raise Refused("credential contains NUL")
    return data


def read_value(stream):
    data = read_credential(stream)
    try:
        data.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        raise Refused("credential is not UTF-8")
    return data


def check_shape(harness, data):
    # Shape only, never the value. Claude setup-token tokens are one line with the sk-ant-oat prefix.
    if harness == "claude" and (not data.startswith(b"sk-ant-oat") or b"\n" in data or len(data) > 512):
        raise Refused("not a claude setup-token")


def install(path, gid, data):
    write_file(ensure_parents(path, gid), path, gid, data)


def write_file(login_dir, path, gid, data):
    """Replace path in login_dir atomically with a root:<gid> 0440 file holding data."""
    if os.path.lexists(path):
        root_owned_not_writable(path, want_dir=False)
    tmp = os.path.join(login_dir, f".{os.path.basename(path)}.{os.getpid()}.new")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    try:
        try:
            os.fchown(fd, 0, gid)
            os.fchmod(fd, 0o440)
            os.write(fd, data + b"\n")
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    dfd = os.open(login_dir, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def run(raw_command, stdin, config_path=CONFIG):
    out = {"ok": False, "harness": None, "name": None, "fingerprint": None, "replacedAt": None}
    try:
        action, harness, name = parse_command(raw_command)
        out.update(harness=harness, name=name)
        path, gid = destination(load_config(config_path), harness, name)
        if action == "install":
            data = read_credential(stdin)
            check_shape(harness, data)
            install(path, gid, data)
            out.update(ok=True, fingerprint=fingerprint(data), replacedAt=now())
        elif action == "remove":
            if os.path.lexists(path):
                root_owned_not_writable(path, want_dir=False)
                os.unlink(path)
            out.update(ok=True, replacedAt=now())
        else:  # status
            if not os.path.lexists(path):
                raise Refused("no credential installed")
            root_owned_not_writable(path, want_dir=False)
            with open(path, "rb") as f:
                data = f.read().strip()
            st = os.lstat(path)
            out.update(ok=True, fingerprint=fingerprint(data),
                       replacedAt=datetime.datetime.fromtimestamp(st.st_mtime, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    except Refused as e:
        out["error"] = str(e)
    except OSError as e:
        out["error"] = f"io error: {type(e).__name__}"
    except Exception as e:  # never leave the caller without a JSON line and a syslog record
        out["error"] = f"internal error: {type(e).__name__}"
    return out


def run_credential(argv, raw_command, stdin, config_path=CONFIG):
    out = {"ok": False, "entry": None, "fingerprint": None, "replacedAt": None}
    try:
        entry = parse_entry(argv)
        out["entry"] = entry
        action = parse_action(raw_command)
        # The client refuses a terminal too: a value typed at a prompt is echoed and kept in scrollback.
        if action == "install" and stdin.isatty():
            raise Refused("stdin is a terminal")
        path, gid, group = credential_destination(load_config(config_path, section="credentials"), entry)
        if action == "install":
            data = read_value(stdin)
            write_file(credentials_dir(path, gid, group, create=True), path, gid, data)
            out.update(ok=True, fingerprint=fingerprint(data), replacedAt=now())
        elif action == "remove":
            if credentials_dir(path, gid, group, create=False) and os.path.lexists(path):
                root_owned_not_writable(path, want_dir=False)
                os.unlink(path)
            out.update(ok=True, replacedAt=now())
        else:  # status
            if not credentials_dir(path, gid, group, create=False) or not os.path.lexists(path):
                raise Refused("no credential installed")
            root_owned_not_writable(path, want_dir=False)
            with open(path, "rb") as f:
                data = f.read().strip()
            st = os.lstat(path)
            out.update(ok=True, fingerprint=fingerprint(data),
                       replacedAt=datetime.datetime.fromtimestamp(st.st_mtime, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    except Refused as e:
        out["error"] = str(e)
    except OSError as e:
        out["error"] = f"io error: {type(e).__name__}"
    except Exception as e:  # never leave the caller without a JSON line and a syslog record
        out["error"] = f"internal error: {type(e).__name__}"
    return out


def main():
    os.umask(0o077)
    raw = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    client = (os.environ.get("SSH_CLIENT", "-").split() or ["-"])[0]
    syslog.openlog("oats-login-receive", 0, syslog.LOG_AUTH)
    if len(sys.argv) > 1:
        out = run_credential(sys.argv[1:], raw, sys.stdin.buffer)
        # Only a validated action and the argv entry id (None unless valid), never the raw command.
        parts = raw.split()
        action = parts[0] if len(parts) == 1 and parts[0] in ACTIONS else "-"
        syslog.syslog(syslog.LOG_NOTICE, "ok=%s action=%s entry=%s fingerprint=%s client=%s" % (
            out["ok"], action, out["entry"], out["fingerprint"], client))
        print(json.dumps(out))
        return 0 if out["ok"] else 1
    out = run(raw, sys.stdin.buffer)
    # Log only the VALIDATED action (never the raw first token: a client that puts the credential in the command
    # line must not write it into the auth log).
    first = (raw.split() or ["-"])[0]
    action = first if first in ACTIONS else "-"
    syslog.syslog(syslog.LOG_NOTICE, "ok=%s action=%s harness=%s name=%s fingerprint=%s client=%s" % (
        out["ok"], action, out["harness"], out["name"], out["fingerprint"], client))
    print(json.dumps(out))
    return 0 if out["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
